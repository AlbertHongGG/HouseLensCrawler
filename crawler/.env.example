# ==============================================================================
# HouseLens Crawler V2 Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 全局爬蟲設定 (Global Crawl Settings)
# ------------------------------------------------------------------------------
# [必填] 決定引擎的執行行為模式
# - full : 完整模式 (根據各爬蟲的 START_URL 進行翻頁，並同步爬取詳細頁)
# - consumer : 消費者模式 (輪詢 Queue，抓出 PENDING 的網址進行詳細頁爬取)
# - targeted : 精準除錯模式 (無視 Queue，直接強制爬取各爬蟲設定的 TARGET_URLS)
CRAWL_MODE=targeted

# [必填] 啟動的爬蟲實體 (可同時多開，以逗號分隔)
# - 房屋爬蟲選項: 591, yungching, sinyi
# - 社區爬蟲選項: 591_community, yungching_community, sinyi_community
ACTIVE_SPIDERS=sinyi, sinyi_community

# ------------------------------------------------------------------------------
# 2. 房屋爬蟲獨立設定 (Site Spiders Configuration)
# ------------------------------------------------------------------------------
# === 591 房屋 ===
SPIDER_591_MAX_ITEMS=50
SPIDER_591_MAX_PAGES=3
SPIDER_591_START_URL="https://sale.591.com.tw/?regionid=1&houseage=$0_$10&firstRow=0&shType=list"
SPIDER_591_TARGET_URLS="https://sale.591.com.tw/home/house/detail/2/20258064.html"

# === 永慶房屋 (Yungching) ===
SPIDER_YUNGCHING_MAX_ITEMS=50
SPIDER_YUNGCHING_MAX_PAGES=3
SPIDER_YUNGCHING_START_URL="https://buy.yungching.com.tw/list/%E5%8F%B0%E5%8C%97%E5%B8%82-_c/0-10_age?pg="
SPIDER_YUNGCHING_TARGET_URLS="https://buy.yungching.com.tw/house/6861494"

# === 信義房屋 (Sinyi) ===
SPIDER_SINYI_MAX_ITEMS=50
SPIDER_SINYI_MAX_PAGES=3
SPIDER_SINYI_START_URL="https://www.sinyi.com.tw/buy/list/0-10-year/Taipei-city/default-desc/"
SPIDER_SINYI_TARGET_URLS="https://www.sinyi.com.tw/buy/house/20165902"


# ------------------------------------------------------------------------------
# 3. 社區爬蟲獨立設定 (Community Spiders Configuration)
# ------------------------------------------------------------------------------
# === 591 社區 ===
SPIDER_591_COMMUNITY_MAX_ITEMS=50
SPIDER_591_COMMUNITY_MAX_PAGES=3
SPIDER_591_COMMUNITY_START_URL="https://market.591.com.tw/list?regionid=1"
SPIDER_591_COMMUNITY_TARGET_URLS="https://market.591.com.tw/49606"

# === 永慶社區 (Yungching) ===
SPIDER_YUNGCHING_COMMUNITY_MAX_ITEMS=50
SPIDER_YUNGCHING_COMMUNITY_MAX_PAGES=3
SPIDER_YUNGCHING_COMMUNITY_START_URL="https://buy.yungching.com.tw/region/community/%e5%8f%b0%e5%8c%97%e5%b8%82_c/"
SPIDER_YUNGCHING_COMMUNITY_TARGET_URLS="https://community.yungching.com.tw/building/55068"

# === 信義社區 (Sinyi) ===
SPIDER_SINYI_COMMUNITY_MAX_ITEMS=50
SPIDER_SINYI_COMMUNITY_MAX_PAGES=3
SPIDER_SINYI_COMMUNITY_START_URL="https://www.sinyi.com.tw/communitylist"
SPIDER_SINYI_COMMUNITY_TARGET_URLS="https://www.sinyi.com.tw/communitylist/communityinfo/0009465"


# ------------------------------------------------------------------------------
# 4. 儲存設定 (Storage Configuration)
# ------------------------------------------------------------------------------
# 決定系統要使用的儲存方式
# [選項] json, supabase
STORAGE_TYPE=json

# --- JSON 儲存細部設定 ---
# JSONL 輸出的相對或絕對路徑 (預設: data/)
JSON_STORAGE_PATH=data/

# --- Supabase 儲存細部設定 (未來擴充用) ---
SUPABASE_URL=postgresql://postgres.your-tenant-id:your_postgres_password@localhost:5432/postgres
POSTGRES_PASSWORD=your_postgres_password
DASHBOARD_PASSWORD=your_dashboard_password
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
S3_PROTOCOL_ACCESS_KEY_ID=your_s3_protocol_access_key_id
S3_PROTOCOL_ACCESS_KEY_SECRET=your_s3_protocol_access_key_secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ------------------------------------------------------------------------------
# 5. 核心引擎與瀏覽器設定 (Engine & Browser Configuration)
# ------------------------------------------------------------------------------
# 爬蟲引擎的併發執行緒數量 (過高可能導致記憶體耗盡或被鎖 IP)
ENGINE_MAX_WORKERS=3

# 是否啟用 Headless (無頭模式)
# [選項] True : 背景執行 (看不到瀏覽器畫面，速度快)
# [選項] False: 顯示瀏覽器畫面 (方便視覺除錯)
BROWSER_HEADLESS=False

# 瀏覽器共用策略 (BROWSER_REUSE_INSTANCE)
# [選項] True : 多爬蟲共用同一個瀏覽器，不關閉 (省資源、速度快)
# [選項] False: 每個爬蟲任務結束後自動關閉，下一個爬蟲開啟全新瀏覽器 (隔離度高)
BROWSER_REUSE_INSTANCE=True

# 視覺化驗證 (Visual Verification)
# 啟動後會在處理網頁時自動截圖 (方便除錯比對 UI 改變)
# [選項] True, False
ENABLE_VISUAL_VERIFICATION=True
